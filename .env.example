NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://hygienelinksupplies.com
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
STAGING_NOINDEX=false

# cPanel MySQL database and user (cPanel normally prefixes both values).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_hygienelinks
DB_USER=cpaneluser_hygienelinks
DB_PASSWORD=replace-with-a-strong-database-password
DB_CONNECTION_LIMIT=10

# CMS administrator. Generate the hash with: npm run cms:password
CMS_ADMIN_EMAIL=admin@hygienelinks.com
CMS_ADMIN_PASSWORD_HASH=scrypt$replace-salt$replace-hash
CMS_SESSION_SECRET=replace-with-at-least-64-random-characters

# Use an absolute path in cPanel, outside public_html when possible.
UPLOAD_DIR=/home/cpaneluser/hygiene-links-storage/uploads

# Enquiry recipient email
ENQUIRY_TO_EMAIL=enquiries@hygienelinks.com
